# ==============================================================================
# NetEvolve .gitignore
# ==============================================================================

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor Files
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# Python Bytecode & Optimization Caches
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
ENV/
env/
.env
.env.local
.env.*.local
!.env.example

# Testing & Linting Caches
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
.cache/

# Node.js, Next.js & Frontend Artifacts
node_modules/
**/node_modules/
.next/
**/.next/
out/
**/out/
.vercel
**/.vercel
*.tsbuildinfo
**/*.tsbuildinfo

# Package Manager Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Runtime Logs
*.log
results/logs/
results/reports/*.tmp

# Data Directory (Ignore large raw and processed dataset arrays)
data/raw/*.csv
data/raw/*.pcap
data/raw/*.parquet
data/interim/*
!data/interim/README.md
data/processed/*.npy
data/processed/*.npz
data/processed/multiview/
data/processed/processed_metadata.json
!data/processed/README.md
!data/raw/README.md
!data/demo/
!data/demo/**

# Temporary Model Checkpoints
models/**/*.tmp
models/**/*.bak
models/checkpoints/

# Temporary Scratchpads
scratch/
.tempmediaStorage/
RoNeTC_Implementation_Plan.md